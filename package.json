{
  "name": "lealnspire",
  "private": true,
  "version": "1.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "verify": "npm run lint && npm run test && npm run build",
    "e2e": "playwright test",
    "e2e:prod": "playwright test -c playwright.prod.config.ts"
  },
  "dependencies": {
    "@fontsource/black-han-sans": "5.3.0",
    "@fontsource/do-hyeon": "5.3.0",
    "@fontsource/gaegu": "5.3.0",
    "@fontsource/gamja-flower": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
