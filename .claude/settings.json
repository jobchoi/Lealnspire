{
  "permissions": {
    "allow": [
      "Bash(git push origin feature/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push origin bugfix/*)",
      "Bash(git push -u origin bugfix/*)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run verify)",
      "Bash(npm ci)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b feature/*)",
      "Bash(git switch -c feature/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * develop*)",
      "Bash(git push * master*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * :*)"
    ]
  }
}
